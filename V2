local BUTTON_TEXT_SIZE = screenW <= 400 and 10 or 11


local blur = Instance.new("BlurEffect")
blur.Size = 12
blur.Enabled = false
blur.Parent = game.Lighting


local function copyToClipboard(text)
    if setclipboard then
        setclipboard(text)
    elseif syn and syn.write_clipboard then
        syn.write_clipboard(text)
    elseif clipboard then
        clipboard.set(text)
    else
        local textBox = Instance.new("TextBox")
        textBox.Text = text
        textBox.ClearTextOnFocus = false
        textBox.Parent = playerGui
        textBox:CaptureFocus()
        wait()
        textBox:ReleaseFocus()
        textBox:Destroy()
    end
end


local function createDialog(config)
    local gui = Instance.new("ScreenGui")
    gui.Name = config.name
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.ResetOnSpawn = false
    gui.Parent = playerGui
    
    local container = Instance.new("Frame")
    container.Name = "Container"
    container.AnchorPoint = Vector2.new(0.5, 0)
    container.Position = UDim2.new(0.5, 0, -0.5, 0)
    container.Size = UDim2.new(0, DIALOG_WIDTH, 0, DIALOG_HEIGHT)
    container.BackgroundTransparency = 1
    container.Parent = gui
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
    mainFrame.BackgroundTransparency = 0.2
    mainFrame.BorderSizePixel = 0
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.Parent = container
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = mainFrame
    
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = config.strokeColor
    stroke.Transparency = 0.3
    stroke.Thickness = 1.2
    stroke.Parent = mainFrame
    
    
    local snowContainer = Instance.new("Frame")
    snowContainer.Name = "SnowContainer"
    snowContainer.BackgroundTransparency = 1
    snowContainer.Size = UDim2.new(1, 0, 1, 0)
    snowContainer.ClipsDescendants = true
    snowContainer.ZIndex = 0
    snowContainer.Parent = mainFrame
    
    for i = 1, 15 do
        local flake = Instance.new("Frame")
        flake.BackgroundColor3 = config.snowColor
        flake.BorderSizePixel = 0
        local size = math.random(2, 3)
        flake.Size = UDim2.fromOffset(size, size)
        local c = Instance.new("UICorner", flake)
        c.CornerRadius = UDim.new(1, 0)
        flake.Position = UDim2.new(math.random(), 0, -0.1, 0)
        flake.Parent = snowContainer
        
        task.spawn(function()
            local speed = math.random(30, 60) / 1000
            local sway = math.random(-10, 10) / 100
            while flake.Parent do
                flake.Position += UDim2.fromOffset(sway, speed * 80)
                flake.Rotation += sway * 2
                if flake.AbsolutePosition.Y > container.AbsolutePosition.Y + container.AbsoluteSize.Y then
                    flake.Position = UDim2.new(math.random(), 0, -0.1, 0)
                end
                task.wait(0.04)
            end
        end)
    end
    
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Text = config.title
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextSize = TITLE_SIZE
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size = UDim2.new(1, -12, 0, 28)
    titleLabel.Position = UDim2.new(0, 6, 0, 4)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 2
    titleLabel.Parent = mainFrame
    
    local textGradient = Instance.new("UIGradient")
    textGradient.Color = config.titleGradient
    textGradient.Parent = titleLabel
    
    
    local divider = Instance.new("Frame")
    divider.BackgroundColor3 = config.strokeColor
    divider.BackgroundTransparency = 0.5
    divider.BorderSizePixel = 0
    divider.Position = UDim2.new(0.05, 0, 0, 30)
    divider.Size = UDim2.new(0.9, 0, 0, 1)
    divider.Parent = mainFrame
    
    
    local messageLabel = Instance.new("TextLabel")
    messageLabel.Name = "MessageLabel"
    messageLabel.Font = Enum.Font.Gotham
    messageLabel.Text = ""
    messageLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
    messageLabel.TextSize = TEXT_SIZE
    messageLabel.TextWrapped = true
    messageLabel.TextXAlignment = config.textAlign
    messageLabel.TextYAlignment = Enum.TextYAlignment.Top
    messageLabel.LineHeight = 1.15
    messageLabel.BackgroundTransparency = 1
    messageLabel.Size = UDim2.new(1, -12, 0, DIALOG_HEIGHT - 85)
    messageLabel.Position = UDim2.new(0, 6, 0, 36)
    messageLabel.ZIndex = 2
    messageLabel.Parent = mainFrame
    
    
    local buttonsFrame = Instance.new("Frame")
    buttonsFrame.Name = "ButtonsFrame"
    buttonsFrame.BackgroundTransparency = 1
    buttonsFrame.Size = UDim2.new(1, -10, 0, 28)
    buttonsFrame.Position = UDim2.new(0, 5, 1, -34)
    buttonsFrame.ZIndex = 3
    buttonsFrame.Parent = mainFrame
    
    local buttonLayout = Instance.new("UIListLayout")
    buttonLayout.FillDirection = Enum.FillDirection.Horizontal
    buttonLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    buttonLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    buttonLayout.Padding = UDim.new(0, 6)
    buttonLayout.Parent = buttonsFrame
    
  
    local copyButton = Instance.new("TextButton")
    copyButton.Name = "CopyButton"
    copyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 100)
    copyButton.Font = Enum.Font.GothamBold
    copyButton.Text = config.copyText
    copyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    copyButton.TextSize = BUTTON_TEXT_SIZE
    copyButton.Size = UDim2.new(0.48, 0, 1, 0)
    copyButton.Visible = false
    copyButton.ZIndex = 3
    copyButton.Parent = buttonsFrame
    
    local copyCorner = Instance.new("UICorner")
    copyCorner.CornerRadius = UDim.new(0, 6)
    copyCorner.Parent = copyButton
    
    
    local okButton = Instance.new("TextButton")
    okButton.Name = "OkButton"
    okButton.BackgroundColor3 = config.okColor
    okButton.Font = Enum.Font.GothamBold
    okButton.Text = config.okText
    okButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    okButton.TextSize = BUTTON_TEXT_SIZE
    okButton.Size = UDim2.new(0.48, 0, 1, 0)
    okButton.Visible = false
    okButton.ZIndex = 3
    okButton.Parent = buttonsFrame
    
    local okCorner = Instance.new("UICorner")
    okCorner.CornerRadius = UDim.new(0, 6)
    okCorner.Parent = okButton
    
   
    copyButton.MouseButton1Click:Connect(function()
        copyToClipboard(DISCORD_LINK)
        copyButton.Text = config.copiedText
        copyButton.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
        task.wait(1.5)
        copyButton.Text = config.copyText
        copyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 100)
    end)
    
    local function hide()
        local exitTween = TweenService:Create(container, TweenInfo.new(0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Position = UDim2.new(0.5, 0, -0.5, 0)})
        exitTween:Play()
        exitTween.Completed:Connect(function()
            gui:Destroy()
            if config.name == "EnglishTranslation" then
                blur.Enabled = false
            end
        end)
    end
    
    okButton.MouseButton1Click:Connect(hide)
    
    local function show(targetX, targetY)
        blur.Enabled = true
        local entryTween = TweenService:Create(container, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = UDim2.new(targetX, 0, targetY, 0)
        })
        entryTween:Play()
        entryTween.Completed:Wait()
        messageLabel.Text = config.message
        copyButton.Visible = true
        okButton.Visible = true
    end
    
    return {
        show = show,
        gui = gui
    }
end


